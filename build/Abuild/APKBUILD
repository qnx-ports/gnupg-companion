# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=gnupg
pkgver=2.4.8
pkgrel=0
pkgdesc="GNU Privacy Guard 2 - meta package for full GnuPG suite"
url="https://www.gnupg.org/"
arch="all"
license="GPL-3.0-or-later"
depends="libiconv libbz2 gettext sqlite zlib xz-libs gnutls libassuan libgcrypt libksba npth pinentry qnx-io-sock"
makedepends="
    libiconv-dev bzip2-dev gettext-dev sqlite-dev zlib-dev xz
    gnutls-dev libassuan-dev libgcrypt-dev libgpg-error-dev libksba-dev npth-dev pinentry
    qnx-io-sock-dev
    autoconf automake libtool texinfo diffutils
"
source="https://gitlab.com/freepg/gnupg/-/archive/gnupg-$pkgver-freepg/gnupg-gnupg-$pkgver-freepg.tar.gz"
builddir="$srcdir/gnupg-gnupg-$pkgver-freepg"

prepare() {
    default_prepare

    # tries to mkdir -p setup.scm/tests but this is a file?
    rm tests/gpgme/setup.scm

    ./autogen.sh
    # We are in fact producing a release. No idea why it's doing this
    sed -i "s:development_version=yes:development_version=no:g" configure
}

build() {
    pwd
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --localstatedir=/var \
	--libexecdir=/usr/lib \
	--enable-maintainer-mode \
        --disable-nls \
        --enable-bzip2 \
        --enable-tofu \
        --disable-scdaemon \
        --disable-ccid-driver \
	--disable-doc
    # No PGP Smartcards for now
    make
}

check() {
    make check || true
}

package() {
    make DESTDIR="$pkgdir" install

    cd "$pkgdir"

    # Remove gpg scheme interpreter - an internal tool used in gpg tests
    rm -rf usr/bin/gpgscm
}

sha512sums="
34479e02fc10031965f094d1d968341588f0779e91e47dd6a1a1046404bc9eb7174ef1fb7c966e79954923713b543f2181031322201e34c5b6b753cc62a7a4e4  gnupg-gnupg-2.4.8-freepg.tar.gz
"
